datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  memberId           String   @unique
  role               String   @default("user")  // admin 或 user（系統層級）
  groups             GroupMember[]
  projectMemberships ProjectMember[]
  ownedProjects      Project[]
  createdAt          DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  completion  Int       @default(0)
  assignee    String    @default("")
  groupId     String    @default("")
  startDate   String    @default("")
  endDate     String    @default("")
  timeLogs    Json      @default("[]")
  columnId    String    @default("todo")
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtasks    SubTask[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SubTask {
  id          String @id @default(cuid())
  title       String
  description String @default("")
  assignee    String @default("")
  groupId     String @default("")
  startDate   String @default("")
  endDate     String @default("")
  completion  Int    @default(0)
  timeLogs    Json   @default("[]")
  taskId      String
  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Project {
  id              String           @id @default(cuid())
  name            String
  description     String           @default("")
  color           String           @default("#6366f1")
  ownerId         String?
  owner           User?            @relation(fields: [ownerId], references: [id])
  members         ProjectMember[]
  tasks           Task[]
  groups          Group[]
  meetingSeries   MeetingSeries[]
  risks           Risk[]
  weeklyReports   WeeklyReport[]
  createdAt       DateTime         @default(now())
}

model Group {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("#6366f1")
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  createdAt DateTime      @default(now())
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String @default("member")  // owner, pm, group_leader, member, viewer

  @@unique([groupId, userId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("member")  // owner, pm, group_leader, member, viewer

  @@unique([projectId, userId])
}

model MeetingSeries {
  id        String          @id @default(cuid())
  name      String
  type      String          @default("regular")
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records   MeetingRecord[]
  createdAt DateTime        @default(now())
}

model MeetingRecord {
  id           String         @id @default(cuid())
  date         String
  attendees    Json           @default("[]")
  summary      String         @default("")
  externalLink String         @default("")
  seriesId     String
  series       MeetingSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
}

model Risk {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  probability     String   @default("medium")
  impact          String   @default("medium")
  countermeasure  String   @default("")
  ownerId         String   @default("")
  ownerGroupId    String   @default("")
  status          String   @default("monitoring")
  createdDate     String   @default("")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model WeeklyReport {
  id        String   @id @default(cuid())
  weekStart String
  weekEnd   String
  notes     String   @default("")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, weekStart])
}