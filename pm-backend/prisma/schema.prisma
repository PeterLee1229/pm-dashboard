datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  memberId           String   @unique
  role               String   @default("user")
  groupId            String?
  group              Group?   @relation(fields: [groupId], references: [id])
  projectMemberships ProjectMember[]
  ownedProjects      Project[]
  createdAt          DateTime @default(now())
  notifications      Notification[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  completion  Int       @default(0)
  assignee    String    @default("")
  groupId     String    @default("")
  startDate   String    @default("")
  endDate     String    @default("")
  timeLogs    Json      @default("[]")
  columnId    String    @default("todo")
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtasks    SubTask[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SubTask {
  id          String @id @default(cuid())
  title       String
  description String @default("")
  assignee    String @default("")
  groupId     String @default("")
  startDate   String @default("")
  endDate     String @default("")
  completion  Int    @default(0)
  timeLogs    Json   @default("[]")
  taskId      String
  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Project {
  id          String           @id @default(cuid())
  name        String
  description String           @default("")
  color       String           @default("#6366f1")
  ownerId     String?
  owner       User?            @relation(fields: [ownerId], references: [id])
  tasks       Task[]
  members     ProjectMember[]
  meetingSeries MeetingSeries[]
  risks       Risk[]
  weeklyReports WeeklyReport[]
  createdAt   DateTime         @default(now())
}

// Group 不再綁專案，改成系統層級（公司組織架構）
model Group {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("#6366f1")
  users     User[]
  createdAt DateTime      @default(now())
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("member")  // owner, pm, group_leader, member, viewer

  @@unique([projectId, userId])
}

model MeetingSeries {
  id        String          @id @default(cuid())
  name      String
  type      String          @default("regular")
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records   MeetingRecord[]
  createdAt DateTime        @default(now())
}

model MeetingRecord {
  id           String         @id @default(cuid())
  date         String
  attendees    Json           @default("[]")
  summary      String         @default("")
  externalLink String         @default("")
  seriesId     String
  series       MeetingSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
}

model Risk {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  probability     String   @default("medium")
  impact          String   @default("medium")
  countermeasure  String   @default("")
  ownerId         String   @default("")
  ownerGroupId    String   @default("")
  status          String   @default("monitoring")
  createdDate     String   @default("")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model WeeklyReport {
  id        String   @id @default(cuid())
  weekStart String
  weekEnd   String
  notes     String   @default("")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, weekStart])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  projectId String?
  taskId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}