datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  memberId           String   @unique
  role               String   @default("user")
  isActive           Boolean  @default(true)
  groupId            String?
  group              Group?   @relation(fields: [groupId], references: [id])
  projectMemberships ProjectMember[]
  ownedProjects      Project[]
  createdAt          DateTime @default(now())
  notifications      Notification[]
  comments           Comment[]
  activityLogs       ActivityLog[]
  attachments        Attachment[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  completion  Int       @default(0)
  assignee    String    @default("")
  groupId     String    @default("")
  startDate   String    @default("")
  endDate     String    @default("")
  timeLogs    Json      @default("[]")
  columnId    String    @default("todo")
  completedAt DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtasks    SubTask[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
  attachments Attachment[]
}

model SubTask {
  id          String @id @default(cuid())
  title       String
  description String @default("")
  assignee    String @default("")
  groupId     String @default("")
  startDate   String @default("")
  endDate     String @default("")
  completion  Int    @default(0)
  timeLogs    Json   @default("[]")
  taskId      String
  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Project {
  id            String           @id @default(cuid())
  name          String
  description   String           @default("")
  color         String           @default("#6366f1")
  ownerId       String?
  owner         User?            @relation(fields: [ownerId], references: [id])
  /// 封存時間；封存的專案為唯讀，預設不出現在專案清單、逾期提醒與跨專案查詢
  archivedAt    DateTime?
  /// 封存者的使用者 id
  archivedBy    String?
  tasks         Task[]
  members       ProjectMember[]
  meetingSeries MeetingSeries[]
  risks         Risk[]
  weeklyReports WeeklyReport[]
  createdAt     DateTime         @default(now())
  objectives    Objective[]
}

// Group 不再綁專案，改成系統層級（公司組織架構）
model Group {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("#6366f1")
  users     User[]
  createdAt DateTime      @default(now())
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("member")  // owner, pm, group_leader, member, viewer

  @@unique([projectId, userId])
}

model MeetingSeries {
  id        String          @id @default(cuid())
  name      String
  type      String          @default("regular")
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records   MeetingRecord[]
  createdAt DateTime        @default(now())
}

model MeetingRecord {
  id           String         @id @default(cuid())
  date         String
  attendees    Json           @default("[]")
  summary      String         @default("")
  externalLink String         @default("")
  seriesId     String
  series       MeetingSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
}

model Risk {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  probability     String   @default("medium")
  impact          String   @default("medium")
  countermeasure  String   @default("")
  ownerId         String   @default("")
  ownerGroupId    String   @default("")
  status          String   @default("monitoring")
  createdDate     String   @default("")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model WeeklyReport {
  id        String   @id @default(cuid())
  weekStart String
  weekEnd   String
  notes     String   @default("")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, weekStart])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  projectId String?
  taskId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String
  targetId  String?
  detail    String   @default("")
  projectId String?
  /// 操作來源：web（網頁）、mcp（AI connector）、assistant（內建助理，Phase 3）
  source     String   @default("web")
  /// 經由 AI 工具操作時的 client 名稱（例如 Claude）
  clientName String?
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   @default("link")
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader  User     @relation(fields: [uploaderId], references: [id])
  createdAt DateTime @default(now())
}

model Objective {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  startDate   String      @default("")
  endDate     String      @default("")
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyResults  KeyResult[]
  createdAt   DateTime    @default(now())
}

model KeyResult {
  id          String    @id @default(cuid())
  title       String
  targetValue Float     @default(100)
  currentValue Float    @default(0)
  unit        String    @default("%")
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
// ── MCP connector（OAuth 2.1 授權伺服器 + 稽核） ─────────────────────
// token、code、client secret 一律只存 SHA-256 hash

model OAuthClient {
  id               String   @id @default(cuid())
  clientId         String   @unique
  clientSecretHash String?
  clientName       String?
  redirectUris     String[]
  /// DCR 註冊時的完整 client metadata（不含 secret），用於還原 OAuthClientInformationFull
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
}

model OAuthAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String?
  expiresAt     DateTime  // 10 分鐘
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

model OAuthToken {
  id               String    @id @default(cuid())
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  clientId         String
  userId           String
  scope            String
  resource         String?
  /// 由哪一個 auth code 核發（refresh rotate 時沿用），code 被重複使用時據此撤銷整串 token
  authCodeId       String?
  accessExpiresAt  DateTime  // 1 小時
  refreshExpiresAt DateTime  // 30 天
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([authCodeId])
}

model McpAuditLog {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  tool        String
  params      Json
  resultCount Int?
  success     Boolean
  errorCode   String?
  durationMs  Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SystemSetting {
  id         Int      @id @default(1) // 整張表只有一列
  mcpEnabled Boolean  @default(false)
  /// AI 寫入工具開關；mcpEnabled 與 mcpWriteEnabled 都為 true 時寫入工具才能使用
  mcpWriteEnabled Boolean @default(false)
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

/// 寫入工具的冪等紀錄：同一使用者以同一個 key 重送時，回傳第一次的結果（24 小時內有效）
model ToolIdempotency {
  id          String   @id @default(cuid())
  key         String
  userId      String
  tool        String
  requestHash String
  resultJson  Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, tool, key])
  @@index([expiresAt])
}
